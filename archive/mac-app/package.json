{
  "name": "worker-ledger-ai",
  "version": "1.0.0",
  "description": "本地化AI记账工作台 - 基于oMLX的智能记账应用",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:dev": "electron-builder --mac --dir",
    "dist": "npm run build",
    "clean": "rm -rf dist/ out/ *.app",
    "install-deps": "npm install",
    "postinstall": "npm run install-deps"
  },
  "keywords": [
    "记账",
    "AI",
    "oMLX",
    "Mac应用",
    "本地化",
    "智能记账"
  ],
  "author": "Worker Ledger Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/worker-ledger-ai"
  },
  "homepage": "https://github.com/your-username/worker-ledger-ai#readme",
  "build": {
    "appId": "com.workerledger.ai",
    "productName": "Worker Ledger AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Worker Ledger AI",
      "icon": "resources/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^latest"
  },
  "dependencies": {
    "electron-store": "^latest",
    "electron-updater": "^latest",
    "node-fetch": "^latest",
    "toml": "^latest"
  }
}
